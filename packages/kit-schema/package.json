{
  "name": "@budaknyenyel/kit-schema",
  "version": "0.1.0",
  "description": "Shared schemas for Android Kit tools",
  "license": "MIT",
  "homepage": "https://github.com/fridaysundaymood/android-kit#readme",
  "bugs": "https://github.com/fridaysundaymood/android-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fridaysundaymood/android-kit.git",
    "directory": "packages/kit-schema"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./result.v1.json": "./result.v1.json",
    "./config.v1.json": "./config.v1.json"
  },
  "files": [
    "dist",
    "result.v1.json",
    "config.v1.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.1"
  }
}
