{
  "name": "@budaknyenyel/kit-cli",
  "version": "0.1.0",
  "description": "Android Kit command-line interface",
  "license": "MIT",
  "homepage": "https://github.com/fridaysundaymood/android-kit#readme",
  "bugs": "https://github.com/fridaysundaymood/android-kit/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fridaysundaymood/android-kit.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "kit": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@budaknyenyel/kit-schema": "file:../kit-schema",
    "@budaknyenyel/kit-server": "file:../server"
  }
}
